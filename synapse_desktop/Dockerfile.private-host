# Repository-only private staging building block. Not a public PWA deployment.
# The Node host binds 127.0.0.1 INSIDE its network namespace. A gateway must
# share that namespace (or use a private loopback sidecar arrangement) to reach it.
# Do not publish ports or set SYNAPSE_DESKTOP_HOST_MODE=remote.
FROM node:24-bookworm-slim

WORKDIR /opt/synapse
COPY synapse_desktop/package.json synapse_desktop/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY synapse_desktop/server ./server
COPY synapse_desktop/shared ./shared

ENV NODE_ENV=production
ENV SYNAPSE_DESKTOP_HOST_MODE=local

# The private host must not execute agent commands or PTYs as root. Keep
# writable user state outside the image; mount an isolated workspace/home for
# each user when the private staging topology is implemented.
RUN mkdir -p /home/node/.config && chown -R node:node /home/node
USER node

# No EXPOSE and no published ports: the gateway and per-user isolation are not
# yet wired into a deployable stack. Never bake backend tokens into this image.
CMD ["node", "server/index.ts"]
