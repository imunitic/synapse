with "config/synapse_tools_config.gpr";

project Synapse_Tools is

   for Source_Dirs use ("src", "config/");
   for Object_Dir use "obj/" & Synapse_Tools_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("gen_unicode_tables.adb");

   package Compiler is
      for Default_Switches ("Ada") use Synapse_Tools_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Synapse_Tools;
