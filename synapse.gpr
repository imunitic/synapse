with "config/synapse_config.gpr";
with "synapse_platform.gpr";
with "vendor/tree-sitter/tree_sitter.gpr";

project Synapse is

   for Source_Dirs use
     ("src/core", "src/core/config", "src/core/formats", "src/core/graph",
      "src/core/json", "src/core/notes", "src/core/text", "src/core/util",
      "src/ports", "src/adapters", "src/adapters/caches", "src/adapters/fakes",
      "src/adapters/git", "src/adapters/stores", "src/adapters/system",
      "src/adapters/tree_sitter", "src/commands", "src/commands/checks",
      "src/commands/cli", "src/commands/graph", "src/commands/orient",
      "src/commands/tagging", "src/commands/vault", "src/hooks",
      Synapse_Platform.Platform_Dir, "src/apps", "config/");
   for Object_Dir use "obj/" & Synapse_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("synapse_main.adb", "synapse_hook_main.adb",
                         "synapse_fake_main.adb");

   package Compiler is
      for Default_Switches ("Ada") use Synapse_Config.Ada_Compiler_Switches;
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use Synapse_Platform.Link_Switches;
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Builder is
      for Executable ("synapse_main.adb") use "synapse";
      for Executable ("synapse_hook_main.adb") use "synapse-hook";
      for Executable ("synapse_fake_main.adb") use "synapse-fake";
   end Builder;

end Synapse;
