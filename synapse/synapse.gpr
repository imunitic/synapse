with "config/synapse_config.gpr";
with "synapse_platform.gpr";
with "vendor/tree-sitter/tree_sitter.gpr";

project Synapse is

   for Source_Dirs use
     ("src/core", "src/core/config", "src/core/formats", "src/core/graph",
      "src/core/json", "src/core/notes", "src/core/text", "src/core/util",
      "src/ports", "src/adapters", "src/adapters/caches", "src/adapters/fakes",
      "src/adapters/git", "src/adapters/stores", "src/adapters/system",
      "src/adapters/tree_sitter", Synapse_Platform.Platform_Dir, "config/");
   for Object_Dir use "obj/" & Synapse_Config.Build_Profile;
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use Synapse_Config.Ada_Compiler_Switches;
   end Compiler;

end Synapse;
