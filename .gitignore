.DS_Store
# Scratch cross-compile output -- release.yml's own per-target build dir
# (out/$target/bin/...), also used locally when testing a release by hand.
out/
# The compiled synapse/synapse-hook binaries each platform package ships --
# release.yml's own publish step copies them in fresh from out/ at publish
# time (or a local hand-test does the same); never checked into source.
packages/synapse/platforms/*/bin/
packages/synapse-pipeline/platforms/*/bin/
job.txt
zig-tags.tsv
# Personal, machine-local Claude Code instructions -- never shared, never
# committed by anyone else working in this repo.
CLAUDE.local.md
# One-shot/site-local migration scripts kept outside the repo (moved to
# ~/Development/synapse/scripts/) -- never part of a build or package.
scripts/


# Build products and downloads of the Ada crate.
obj/
bin/
# The npm shim of synapse-pipeline is source, not a build product.
!/packages/synapse-pipeline/bin/
/synapse/config/
/synapse_cli/config/
/synapse_pipeline/config/
/tests/unit/config/
/tests/acceptance/config/
/tools/config/
alire/
/ucd/
/testdata/

# Loose GNAT build products from a one-off compile in this directory.
b~*
*.ali
*.o
*.bexch
