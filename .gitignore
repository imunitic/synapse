.DS_Store
zig-out/
.zig-cache/
# Scratch cross-compile output -- release.yml's own per-target build dir
# (out/$target/bin/...), also used locally when testing a release by hand.
out/
# The compiled synapse/synapse-hook binaries each platform package ships --
# release.yml's own publish step copies them in fresh from out/ at publish
# time (or a local hand-test does the same); never checked into source.
packages/synapse/platforms/*/bin/
# Where zig 0.16 unpacks fetched dependencies -- the global cache under
# ~/.cache/zig/p holds only the tarballs. Build output like the two above,
# not vendored source: `zig build --fetch` refills it from the hash pinned in
# build.zig.zon, and unpacks every version it is ever pointed at without
# collecting the ones no longer named.
zig-pkg/
job.txt
zig-tags.tsv
# Personal, machine-local Claude Code instructions -- never shared, never
# committed by anyone else working in this repo.
CLAUDE.local.md
