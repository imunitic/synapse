{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "synapse-hook session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "synapse-hook prompt-context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Bash|mcp__obsidian__vault_(write|patch|append|delete|move)",
        "hooks": [
          {
            "type": "command",
            "command": "synapse-hook db-sync"
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "synapse-hook staleness"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "synapse-hook stop-nudge"
          }
        ]
      }
    ]
  }
}
