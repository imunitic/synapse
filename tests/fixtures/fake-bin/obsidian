#!/bin/bash
# Fake `obsidian` CLI standing in for the real official binary in tests, so
# ObsidianStore's CLI-backed ops (search, backlinks, links, unresolved,
# orphans, deadends) can be asserted on without a real running Obsidian app.
# Put this directory ahead of the real `obsidian` on PATH.
#
# Logs every invocation verbatim to $FAKE_OBSIDIAN_LOG. Canned responses come
# from $FAKE_OBSIDIAN_SCRIPT, one line per subcommand:
#
#   <subcommand> <stdout to print verbatim>
#
# The first argument (e.g. "search:context", "backlinks", "links",
# "unresolved", "orphans", "deadends") is matched against each line's first
# space-separated field; the remainder of the matching line is printed to
# stdout, with `\n`/`\t` escapes expanded (so one script line can still stand
# in for a multi-line real response, e.g. `obsidian vaults verbose` listing
# more than one vault), and the script exits 0. A leading `vault=<name>`
# argument is skipped for that match (real callers put it before the
# subcommand, same as the real CLI) but still logged verbatim. No line for
# the invoked subcommand is a test-fixture bug, not a real-world case this
# needs to simulate -- it exits non-zero with a message on stderr instead of
# silently returning nothing.
set -euo pipefail

: "${FAKE_OBSIDIAN_LOG:?FAKE_OBSIDIAN_LOG must be set}"
: "${FAKE_OBSIDIAN_SCRIPT:?FAKE_OBSIDIAN_SCRIPT must be set}"
printf '%s\n' "$*" >>"$FAKE_OBSIDIAN_LOG"

args=("$@")
if [[ "${args[0]:-}" == vault=* ]]; then
  args=("${args[@]:1}")
fi
cmd="${args[0]:-}"
while IFS= read -r line || [[ -n "$line" ]]; do
  key="${line%% *}"
  if [[ "$key" == "$cmd" ]]; then
    printf '%b\n' "${line#* }"
    exit 0
  fi
done <"$FAKE_OBSIDIAN_SCRIPT"

echo "fake obsidian: no script line for command '$cmd'" >&2
exit 1
