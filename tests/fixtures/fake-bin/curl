#!/bin/bash
# Fake `curl` standing in for the Obsidian Local REST API in tests, so
# synapse-staleness.sh's HTTP calls can be asserted on without a real
# Obsidian instance. Put this directory ahead of the real curl on PATH.
#
# Logs every invocation verbatim to $FAKE_CURL_LOG, and simulates just
# enough of the Local REST API's /vault/{path} behavior for the hook:
#
#   GET without -o  -> body + "\n<code>" (matching a real curl -w '\n%{http_code}'):
#            $FAKE_CURL_INDEX_BODY's contents + 200 if set and present, else the
#            real API's actual 404 JSON error body + 404 -- NOT an empty body,
#            since that 404 body is itself valid JSON and a bare `jq -e .` check
#            cannot tell it apart from a real note. No shipped caller GETs an
#            index over the API any more; this shape is kept because the 404-body
#            distinction applies to every /vault/{path} GET, not just that one.
#   GET with -o FILE -> node fetch. Serves $FAKE_CURL_VAULT_DIR/<percent-decoded
#            path> into FILE, or exits 22 (curl's -f "HTTP error" code) when the
#            file doesn't exist, so the hook's `|| continue` path is exercised.
#   PUT   -> writes the payload (inline, from a file for --data-binary @path, or
#            from stdin for @-) to $FAKE_CURL_VAULT_DIR/<decoded path> when that dir is set,
#            so tests can diff the resulting bytes, and node PUTs are logged to
#            $FAKE_CURL_CAPTURE_DIR/node-puts.log. Payload files are copied,
#            never round-tripped through a shell variable, so a trailing newline
#            survives and byte-identity assertions mean something.
#   PATCH -> appends the request URL to $FAKE_CURL_CAPTURE_DIR/patches.log. The
#            hook no longer issues these against node frontmatter (that call
#            re-serialises the whole YAML block and YAML-coerces values); a
#            patches.log appearing in a staleness test is now a regression.
#
# The writer scripts (synapse-write-node.sh and the two index builders) check the
# HTTP status instead of relying on curl's exit code, calling
# `curl -o FILE -w '%{http_code}' -X PUT`. So a PUT honours -w by printing a
# status (overridable via $FAKE_CURL_PUT_STATUS, e.g. 500 to exercise the failure
# path) and honours -o by writing a response body there. Printing only when -w was
# actually passed keeps the older callers, which expect silence on PUT, unchanged.
set -euo pipefail

: "${FAKE_CURL_LOG:?FAKE_CURL_LOG must be set}"
printf '%s\n' "$*" >> "$FAKE_CURL_LOG"

args=("$@")
n=${#args[@]}
# The URL is found by pattern, not by position. Assuming it was the last argument
# meant that a call passing --data-binary after the URL silently searched for
# nothing and returned [], which reads as "no results" rather than as a mistake --
# and made a test asserting silence pass for the wrong reason.
url=""
for ((i = 0; i < n; i++)); do
  case "${args[$i]}" in https://*|http://*) url="${args[$i]}" ;; esac
done

method="GET"
data=""
outfile=""
writefmt=""
for ((i = 0; i < n; i++)); do
  case "${args[$i]}" in
    -X) method="${args[$((i+1))]}" ;;
    --data-binary|--data-raw) data="${args[$((i+1))]}" ;;
    -o) outfile="${args[$((i+1))]}" ;;
    -w) writefmt="${args[$((i+1))]}" ;;
  esac
done

# Percent-decode the part after /vault/ -- node titles carry spaces and em
# dashes, which the hook URL-encodes before calling.
vault_path=""
case "$url" in
  */vault/*)
    enc="${url#*/vault/}"
    vault_path="$(printf '%b' "${enc//%/\\x}")"
    ;;
esac

# Writes $data (inline, or read from a file for @path) to $1, byte-exact.
write_payload_to() {
  local dest="$1"
  mkdir -p "$(dirname "$dest")"
  case "$data" in
    # `@-` is the payload on stdin, which real curl accepts and the writer uses:
    # a node runs to megabytes on a hub, and an argument list is bounded. `cat`,
    # not a shell variable, for the same reason the file case is a `cp` -- a
    # trailing newline has to survive for a byte-identity assertion to mean
    # anything.
    @-) cat > "$dest" ;;
    @*) cp "${data#@}" "$dest" ;;
    *) printf '%s' "$data" > "$dest" ;;
  esac
}

case "$method" in
  GET)
    if [ -n "$outfile" ]; then
      # Node fetch, for the read-modify-write of a single `stale:` line.
      src="${FAKE_CURL_VAULT_DIR:-}/$vault_path"
      if [ -n "${FAKE_CURL_VAULT_DIR:-}" ] && [ -f "$src" ]; then
        cp "$src" "$outfile"
        exit 0
      fi
      exit 22
    fi
    if [ -n "${FAKE_CURL_INDEX_BODY:-}" ] && [ -f "$FAKE_CURL_INDEX_BODY" ]; then
      cat "$FAKE_CURL_INDEX_BODY"
      printf '\n200'
    else
      printf '{"message":"Not Found","errorCode":40400}\n404'
    fi
    ;;
  POST)
    # JsonLogic frontmatter search. Emulates the Local REST API's /search/ for the
    # single expression shape the scripts use, {"var":"frontmatter.<field>"},
    # returning [{filename, result}] for every note under $FAKE_CURL_VAULT_DIR
    # whose frontmatter defines that field.
    #
    # Narrow on purpose. A general JsonLogic evaluator in a test fixture would be
    # a reimplementation of someone else's semantics, and the suite would end up
    # verifying this file instead of the endpoint. The real endpoint's response
    # shape was confirmed by hand against a live vault; what these tests cover is
    # the script's handling of it.
    case "$url" in
      */search/*)
        emit() { if [ -n "$outfile" ]; then cat > "$outfile"; else cat; fi; }
        # Per-prompt context injection's shape: {"and": [{"glob": [pat, {"var":"path"}]},
        # {"regexp": [re, {"var":"content"}]}]} -- distinguished from the
        # frontmatter-field shape below by the presence of "glob", which that shape
        # never contains. Handled separately rather than folded into the Python
        # block below: different match semantics entirely (path glob + whole-file
        # regexp vs. a single frontmatter field), so sharing one implementation
        # would just obscure which shape is being tested.
        case "$data" in
          *'"glob"'*)
            [ -n "${FAKE_CURL_VAULT_DIR:-}" ] || { echo '[]' | emit; exit 0; }
            FAKE_CURL_SEARCH_QUERY="$data" ROOT="$FAKE_CURL_VAULT_DIR" python3 - <<'PYEOF' | emit
import json, os, pathlib, re, fnmatch
root = pathlib.Path(os.environ["ROOT"])
q = json.loads(os.environ["FAKE_CURL_SEARCH_QUERY"])
clauses = q["and"]
glob_pat = next(c["glob"][0] for c in clauses if "glob" in c)
regexp_pat = next(c["regexp"][0] for c in clauses if "regexp" in c)
rx = re.compile(regexp_pat)
out = []
for f in sorted(root.rglob("*.md")):
    rel = str(f.relative_to(root))
    if not fnmatch.fnmatch(rel, glob_pat): continue
    content = f.read_text(errors="replace")
    if rx.search(content):
        out.append({"filename": rel, "result": True})
print(json.dumps(out))
PYEOF
            exit 0
            ;;
        esac
        field="$(printf '%s' "$data" | sed -n 's/.*"frontmatter\.\([A-Za-z_][A-Za-z0-9_]*\)".*/\1/p')"
        [ -n "${FAKE_CURL_VAULT_DIR:-}" ] && [ -n "$field" ] || { echo '[]' | emit; exit 0; }
        FIELD="$field" ROOT="$FAKE_CURL_VAULT_DIR" python3 - <<'PYEOF' | emit
import json, os, pathlib, re
root, field = pathlib.Path(os.environ["ROOT"]), os.environ["FIELD"]
out = []
for f in sorted(root.rglob("*.md")):
    t = f.read_text(errors="replace")
    if not t.startswith("---\n"): continue
    fm = t.split("---\n", 2)[1] if t.count("---\n") >= 2 else ""
    # scalar: `field: value`
    m = re.search(rf"(?m)^{re.escape(field)}:[ \t]*(.+)$", fm)
    if m and m.group(1).strip():
        v = m.group(1).strip()
        if len(v) >= 2 and v[0] == '"' and v[-1] == '"':
            # Unescape the double-quoted scalar, as a real YAML parser does before
            # the API hands the value over. Backslashes first, parked on a sentinel:
            # unescaping \" ahead of \\ turns the sequence \\" into a stray quote.
            v = v[1:-1].replace("\\\\", "\x00").replace('\\"', '"').replace("\x00", "\\")
        out.append({"filename": str(f.relative_to(root)), "result": v})
        continue
    # list of maps: `field:` then `  - path: ...` / `    lines: ...` / `    digest: ...`
    m = re.search(rf"(?m)^{re.escape(field)}:[ \t]*$\n((?:[ \t]+.*\n)+)", fm)
    if not m: continue
    items, cur = [], None
    for line in m.group(1).split("\n"):
        kv = re.match(r"\s*-?\s*([A-Za-z_][A-Za-z0-9_]*):\s*(.*)$", line)
        if not kv: continue
        k, v = kv.group(1), kv.group(2).strip().strip('"')
        if line.lstrip().startswith("-"):
            cur = {}; items.append(cur)
        if cur is not None: cur[k] = v
    if items: out.append({"filename": str(f.relative_to(root)), "result": items})
print(json.dumps(out))
PYEOF
        exit 0
        ;;
    esac
    ;;
  PUT)
    put_status="${FAKE_CURL_PUT_STATUS:-200}"
    case "$put_status" in
      2*)
        case "$vault_path" in
          *)
            if [ -n "${FAKE_CURL_VAULT_DIR:-}" ]; then
              write_payload_to "$FAKE_CURL_VAULT_DIR/$vault_path"
            fi
            if [ -n "${FAKE_CURL_CAPTURE_DIR:-}" ]; then
              mkdir -p "$FAKE_CURL_CAPTURE_DIR"
              printf '%s\n' "$vault_path" >> "$FAKE_CURL_CAPTURE_DIR/node-puts.log"
            fi
            ;;
        esac
        [ -n "$outfile" ] && printf '{"message":"OK"}' > "$outfile"
        ;;
      *)
        # Simulated rejection: the payload is deliberately NOT stored, so a test
        # asserting the failure path also proves nothing was written.
        [ -n "$outfile" ] && printf '{"message":"Simulated failure","errorCode":%s}' "$put_status" > "$outfile"
        ;;
    esac
    [ -n "$writefmt" ] && printf '%s' "$put_status"
    ;;
  PATCH)
    [ -n "${FAKE_CURL_CAPTURE_DIR:-}" ] || exit 0
    mkdir -p "$FAKE_CURL_CAPTURE_DIR"
    printf '%s\n' "$url" >> "$FAKE_CURL_CAPTURE_DIR/patches.log"
    ;;
esac
exit 0
