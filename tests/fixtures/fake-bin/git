#!/bin/bash
# Fake `git` for `synapse tags`: intercepts only `clone` (creating
# the destination directory instead of touching the network) and delegates
# every other subcommand to the real `git`, stripping this directory from
# PATH first so it doesn't recurse into itself. This matters because other
# tests also prepend this fake-bin directory onto PATH and rely on *real*
# `git rev-parse`/`git hash-object` working inside the hook they're testing --
# a git stub that only handled `clone` and errored on everything else would
# silently break those tests too, since they share this same fixtures directory.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ "${1:-}" = "clone" ]; then
  [ -n "${FAKE_GIT_LOG:-}" ] && printf '%s\n' "$*" >> "$FAKE_GIT_LOG"
  args=("$@")
  dest="${args[$((${#args[@]}-1))]}"
  mkdir -p "$dest"
  exit 0
fi

CLEAN_PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -v -F "$SELF_DIR" | paste -sd: -)"
PATH="$CLEAN_PATH" exec git "$@"
