#!/bin/bash
# Fake `tree-sitter` standing in for the real CLI in tests, so
# synapse-tags.sh's control flow (registry lookup -> clone -> register ->
# invoke tags) can be asserted on without a real tree-sitter install or a
# real grammar build. Logs every invocation to $FAKE_TS_LOG if set.
#
# Symbol names: every file yields `FAKE_NAME`, and additionally one tag per
# `symbol:<Name>` line in the file itself. That keeps every pre-existing test
# (whose fixtures contain no such line) seeing exactly what it always did,
# while letting a test that cares about *vocabulary* -- synapse-vocab.sh's
# CamelCase splitting, stopwording, per-group term distribution -- author the
# symbols it wants as ordinary fixture content rather than needing a second fake.
set -euo pipefail

[ -n "${FAKE_TS_LOG:-}" ] && printf '%s\n' "$*" >> "$FAKE_TS_LOG"

# Tag lines for one path, UNINDENTED and with no path line -- the caller adds
# both when the batch shape calls for them. Returns 1 when this fake pretends to
# have no grammar for the extension, which is a different thing from returning
# no tags: the first is absent from batch output entirely, the second still gets
# its path line, and that distinction is what `unsupported` rests on.
emit_tags() { # emit_tags <path>
  local p="$1" name
  case "$p" in
    *.ml|*.java|*.py) ;;
    *) return 1 ;;
  esac
  # A file containing `notags` parses fine and simply has nothing in it.
  if [ -f "$p" ] && LC_ALL=C grep -qx 'notags' "$p" 2>/dev/null; then
    return 0
  fi
  printf 'FAKE_NAME\t | function\tdef (0, 0) - (0, 1) `fake source line`\n'
  [ -f "$p" ] || return 0
  # `symbol:` is a definition, `ref:` a reference. The distinction matters to
  # synapse-rank.sh, which ranks by definitions per KB: a reference says the
  # file USES something, a definition says it DECLARES it, and only the second
  # is evidence of what a subsystem is.
  while IFS= read -r line; do
    case "$line" in
      symbol:*) name="${line#symbol:}"
                [ -n "$name" ] || continue
                printf '%s\t | function\tdef (0, 0) - (0, 1) `fake source line`\n' "$name" ;;
      ref:*)    name="${line#ref:}"
                [ -n "$name" ] || continue
                printf '%s\t | call\tref (0, 0) - (0, 1) `fake source line`\n' "$name" ;;
    esac
  done < "$p"
}

case "${1:-}" in
  init-config)
    mkdir -p "$HOME/.config/tree-sitter"
    printf '{}' > "$HOME/.config/tree-sitter/config.json"
    ;;
  tags)
    if [ "${2:-}" = "--paths" ] && [ -n "${3:-}" ]; then
      # THE REAL CLI CHANGES SHAPE AT ONE PATH, and this fake reproduces that
      # deliberately. Given a list of two or more it prints an unindented path
      # line followed by that path's tab-indented tags; given a list of exactly
      # ONE it prints neither -- just the bare tags, identical to single-file
      # form, matching tree-sitter 0.25.10's real CLI.
      #
      # An earlier version of this fake always printed path lines, and that lie
      # let a real bug ship: a caller attributing batch output saw no path line
      # for a one-file chunk, concluded the file was absent from the output, and
      # cached a perfectly parseable file as `unsupported: true`. A one-file
      # chunk is the COMMON case -- one source changed, re-tag it -- so the fake
      # has to be honest about the shape or the suite cannot see the failure.
      n_paths="$(LC_ALL=C awk 'NF { n++ } END { print n + 0 }' "$3")"
      while IFS= read -r p; do
        [ -n "$p" ] || continue
        # Logged per path as well as per invocation: once a caller batches, the
        # count of invocations no longer tells a test WHICH files were tagged,
        # and "only the changed file was re-tagged" is the property worth
        # asserting. The chunk list itself lives in a work dir that is gone by
        # the time the test looks.
        [ -n "${FAKE_TS_LOG:-}" ] && printf 'path %s\n' "$p" >> "$FAKE_TS_LOG"
        if [ "$n_paths" -eq 1 ]; then
          emit_tags "$p" || true
        elif out="$(emit_tags "$p")"; then
          printf '%s\n' "$p"
          printf '%s' "$out" | LC_ALL=C awk 'NF { print "\t" $0 }'
        fi
      done < "$3"
    else
      # Single-file form: --scope <scope> <file>. No path line, because the
      # caller already knows which file it asked about.
      printf 'FAKE_NAME\t | function\tdef (0, 0) - (0, 1) `fake source line`\n'
    fi
    ;;
  *)
    exit 1
    ;;
esac
