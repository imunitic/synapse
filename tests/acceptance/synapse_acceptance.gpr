with "config/synapse_acceptance_config.gpr";
with "aunit.gpr";
with "../../synapse_platform.gpr";

project Synapse_Acceptance is

   for Source_Dirs use
     ("src", "../../src/core", "../../src/core/config", "../../src/core/formats",
      "../../src/core/graph", "../../src/core/json", "../../src/core/notes",
      "../../src/core/text", "../../src/core/util", "../../src/ports",
      "../../src/adapters", "../../src/adapters/caches",
      "../../src/adapters/stores", "../../src/adapters/system",
      "../../" & Synapse_Platform.Platform_Dir, "config/");
   for Object_Dir use "obj/" & Synapse_Acceptance_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("synapse_acceptance.adb");

   package Compiler is
      for Default_Switches ("Ada") use Synapse_Acceptance_Config.Ada_Compiler_Switches;
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use Synapse_Platform.Link_Switches;
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Synapse_Acceptance;
