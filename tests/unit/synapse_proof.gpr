--  Everything in synapse/src/core, for GNATprove. A project with no Main, so every unit
--  is analyzed rather than only those reachable from the test runner.
project Synapse_Proof is

   for Source_Dirs use ("../../synapse/src/core", "../../synapse/src/core/config", "../../synapse/src/core/formats",
      "../../synapse/src/core/graph", "../../synapse/src/core/json", "../../synapse/src/core/notes",
      "../../synapse/src/core/text", "../../synapse/src/core/util", "../../synapse/src/ports");
   for Object_Dir use "obj/proof";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatW8", "-gnata");
   end Compiler;

end Synapse_Proof;
