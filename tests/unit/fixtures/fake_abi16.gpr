--  A compiled tree-sitter grammar used by the tests.
library project Fake_Abi16 is

   for Languages use ("C");
   for Source_Dirs use ("fake_abi16/src");
   for Object_Dir use "obj/fake_abi16";
   for Library_Name use "fake_abi16";
   for Library_Dir use "lib";
   for Library_Kind use "dynamic";
   for Create_Missing_Dirs use "True";

end Fake_Abi16;
