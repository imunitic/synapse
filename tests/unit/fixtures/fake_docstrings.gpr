--  A compiled tree-sitter grammar used by the tests.
library project Fake_Docstrings is

   for Languages use ("C");
   for Source_Dirs use ("fake_docstrings/src");
   for Object_Dir use "obj/fake_docstrings";
   for Library_Name use "fake_docstrings";
   for Library_Dir use "lib";
   for Library_Kind use "dynamic";
   for Create_Missing_Dirs use "True";

end Fake_Docstrings;
