with "config/synapse_tests_config.gpr";
with "aunit.gpr";
with "../../synapse/synapse_platform.gpr";
with "../../synapse/vendor/tree-sitter/tree_sitter.gpr";

project Synapse_Tests is

   for Source_Dirs use
     ("src/support", "src/core", "src/core/config", "src/core/formats",
      "src/core/graph", "src/core/json", "src/core/notes", "src/core/text",
      "src/core/util", "src/adapters", "src/adapters/caches",
      "src/adapters/fakes", "src/adapters/git", "src/adapters/stores",
      "src/adapters/system", "src/adapters/tree_sitter", "src/commands",
      "src/hooks", "../../synapse/src/core", "../../synapse/src/core/config", "../../synapse/src/core/formats",
      "../../synapse/src/core/graph", "../../synapse/src/core/json", "../../synapse/src/core/notes",
      "../../synapse/src/core/text", "../../synapse/src/core/util", "../../synapse/src/ports", "../../synapse/src/adapters",
      "../../synapse/src/adapters/caches", "../../synapse/src/adapters/fakes", "../../synapse/src/adapters/git",
      "../../synapse/src/adapters/stores", "../../synapse/src/adapters/system",
      "../../synapse/src/adapters/tree_sitter", "../../synapse_cli/src/commands", "../../synapse_cli/src/commands/checks",
      "../../synapse_cli/src/commands/cli", "../../synapse_cli/src/commands/graph", "../../synapse_cli/src/commands/orient",
      "../../synapse_cli/src/commands/tagging", "../../synapse_cli/src/commands/vault", "../../synapse_cli/src/hooks",
      "../../synapse/" & Synapse_Platform.Platform_Dir, "config/");
   for Object_Dir use "obj/" & Synapse_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("synapse_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use Synapse_Tests_Config.Ada_Compiler_Switches;
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use Synapse_Platform.Link_Switches;
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Synapse_Tests;
