.{
    .name = .synapse_bard,
    .version = "0.1.0",

    // Generated once by the toolchain and never changed: together with `name`
    // it is this package's globally unique identity, so that a fork is
    // distinguishable from an update. Changing it has security and trust
    // implications.
    .fingerprint = 0x351ee54619ebcc42,

    // Pinned to the same version the root package requires, since the path
    // dependency below shares its build with this one -- see the root
    // `build.zig.zon`'s own comment for why it's pinned rather than tracking
    // latest.
    .minimum_zig_version = "0.16.0",

    .dependencies = .{
        // A path dependency, not a fetched one: bard reuses the repo root's
        // `model`/`ports`/`core`/`adapters` modules directly from this
        // checkout, with no hash to pin and no network fetch. `bard/build.zig`
        // never requests the root's `treesitter` module, so libtree-sitter and
        // the C toolchain it needs never enter this build.
        .synapse = .{ .path = ".." },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
