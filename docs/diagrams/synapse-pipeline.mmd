---
title: Synapse — how the pieces fit
---
%% Colour carries the lane: what the MODEL judges, what a SCRIPT executes, what
%% lands in the VAULT, and what is merely DERIVED into the work dir. Subgraphs
%% carry the phase.
%% --
%% Read the yellow boxes' arrows in both directions and the whole design is
%% there. Blue enters yellow twice -- vocabulary into clustering, ranked files
%% into authoring -- and that is the evidence a judgment is made over, derived
%% mechanically rather than gathered by hand. Yellow leaves for blue twice --
%% manifest.tsv and the authored bodies -- and that is the seam, the only place
%% interpretation is handed back to the scripts. Everything else is mechanical.
%% --
%% Boxes carry NAMES, not descriptions. What each one actually does lives in the
%% reference table under this diagram in docs/synapse-graph.md. A box holding four
%% lines of mechanism is a paragraph in a rectangle: it cannot be read at a glance,
%% which is the only thing a diagram is better at than prose. Keep labels to a name
%% plus at most a three-word role, and put the detail in the table.
%% --
%% Separator lines are `%% --`, never a bare `%%`: an empty comment swallows the
%% following newline, so the next line is parsed glued onto it -- a bare `%%`
%% directly above `flowchart TB` fails with "Parse error on line 1: %%flowchart".
flowchart TB
    classDef model fill:#ffec99,stroke:#e8590c,color:#1e1e1e
    classDef seam fill:#ffc9c9,stroke:#c2255c,color:#1e1e1e,stroke-width:3px
    classDef script fill:#d0ebff,stroke:#1971c2,color:#1e1e1e
    classDef vault fill:#d3f9d8,stroke:#2f9e44,color:#1e1e1e
    classDef work fill:#e9ecef,stroke:#868e96,color:#1e1e1e
    classDef hook fill:#ffd8a8,stroke:#e8590c,color:#1e1e1e
    classDef cmd fill:#e5dbff,stroke:#6741d9,color:#1e1e1e

    subgraph BUILD["BUILD · /synapse-init"]
        direction TB
        TAGS["synapse tags"]
        VOCAB["synapse-vocab.sh<br/>symbol vocabulary"]
        ORIENT["<b>model</b><br/>orient and cluster"]
        MANIFEST["<b>manifest.tsv</b><br/>THE SEAM"]
        LISTS["synapse-build-lists.sh<br/>enumerate and expand"]
        GATE["synapse-gate.sh<br/>flag empty clusters"]
        RANK["synapse-rank.sh<br/>what to read"]
        PROSE["<b>model</b><br/>author node prose"]
        PUSH["synapse-push-nodes.sh"]
        WRITE["synapse-write-node.sh<br/>hash, slice, write"]
        IDX["synapse-build-index.sh"]
        PIDX["synapse-build-project-index.sh"]

        TAGS -->|"batched"| VOCAB
        VOCAB -->|"evidence"| ORIENT
        ORIENT -->|"authors"| MANIFEST
        MANIFEST --> LISTS
        LISTS --> GATE
        GATE -.->|"re-cluster"| ORIENT
        LISTS --> RANK
        RANK -->|"top-N"| PROSE
        LISTS -->|"path lists"| PUSH
        PROSE -->|"bodies"| PUSH
        PUSH -->|"per node"| WRITE
        WRITE --> IDX --> PIDX
    end

    subgraph VAULT["VAULT · synapse/{repo}@{branch}/"]
        direction LR
        NODE["{Node Title}.md × N"]
        INDEX["Index.md"]
        AUX["_manifest.tsv · _profile.txt"]
    end

    subgraph WORK["WORK DIR · ~/.claude/synapse-work/{repo}@{branch}/"]
        direction LR
        IDXBIN["_index.bin"]
        TAGSCACHE["_tags_cache.bin"]
        REFSIDX["_refs.tsv"]
        WORDS["groupwords.tsv · counts.tsv"]
    end

    WRITE ==>|"REST PUT"| NODE
    IDX ==> IDXBIN
    PIDX ==> INDEX
    WRITE -.->|"byproduct"| TAGSCACHE
    VOCAB -.-> WORDS

    subgraph USE["READ · DETECT · REPAIR"]
        direction TB
        QUERY["synapse-query.sh<br/>body · sources · field"]
        SYMBOL["synapse-query.sh symbol"]
        REFS["synapse-build-refs.sh"]
        CALLERS["synapse-query.sh callers"]
        NODESKILL["synapse-node skill<br/>Tier 2"]
        STALE1["synapse-staleness.sh<br/>Tier 1"]
        STALE2["synapse-query.sh stale"]
        DRIFT["synapse-query.sh drift"]
        GROUND["synapse-query.sh grounding"]
        REBUILDDIFF["/synapse-rebuild-diff<br/><i>same branch only</i>"]
        REBUILDFULL["/synapse-rebuild-full"]
        CLEAN["synapse-graph-clean.sh"]
        WIPE["synapse-graph-wipe.sh<br/>preserves ## Notes"]

        DRIFT --> REBUILDDIFF
        GROUND --> REBUILDDIFF
        REBUILDFULL -.->|"wipes"| WIPE
    end

    NODE -.->|"read"| QUERY
    NODE -.-> NODESKILL
    IDXBIN -.-> STALE1
    NODE -.-> STALE2
    NODE -.-> DRIFT
    NODE -.-> GROUND
    NODE -.->|"sources"| SYMBOL
    TAGSCACHE -.->|"read"| SYMBOL
    SYMBOL -.->|"backfill"| TAGSCACHE
    TAGSCACHE -.->|"project"| REFS
    REFS -.-> REFSIDX
    REFSIDX -.->|"look + awk"| CALLERS
    REBUILDDIFF ==>|"re-writes nodes"| WRITE
    REBUILDFULL ==>|"re-runs full build"| BUILD
    CLEAN -.->|"deletes namespace"| NODE
    WIPE -.->|"deletes namespace"| NODE

    class ORIENT,PROSE model
    class MANIFEST seam
    class LISTS,PUSH,WRITE,IDX,PIDX,TAGS,VOCAB,GATE,RANK,QUERY,SYMBOL,REFS,CALLERS,STALE2,DRIFT,GROUND,CLEAN,WIPE script
    class NODE,INDEX,AUX vault
    class IDXBIN,TAGSCACHE,REFSIDX,WORDS work
    class STALE1 hook
    class REBUILDDIFF,REBUILDFULL,NODESKILL cmd

    subgraph KEY["the colours"]
        direction LR
        K1["model judgment"]
        K2["the seam"]
        K3["script — mechanics"]
        K4["vault artifact"]
        K7["derived · disposable"]
        K5["fires automatically"]
        K6["command / skill"]
    end
    class K1 model
    class K2 seam
    class K3 script
    class K4 vault
    class K7 work
    class K5 hook
    class K6 cmd

    %% Neutral subgraph fills: the default pale yellow competes with the model
    %% lane's own yellow, and the point of the palette is that the lane is
    %% readable at a glance.
    style BUILD fill:#ffffff,stroke:#adb5bd,stroke-dasharray:4 4
    style VAULT fill:#ffffff,stroke:#adb5bd,stroke-dasharray:4 4
    style WORK fill:#ffffff,stroke:#adb5bd,stroke-dasharray:4 4
    style USE fill:#ffffff,stroke:#adb5bd,stroke-dasharray:4 4
    style KEY fill:#ffffff,stroke:#adb5bd,stroke-dasharray:4 4
