with "config/synapse_config.gpr";

project Synapse is

   for Source_Dirs use ("src/core", "src/ports", "src/adapters", "src/apps", "config/");
   for Object_Dir use "obj/" & Synapse_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("synapse_main.adb");

   package Compiler is
      for Default_Switches ("Ada") use Synapse_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Builder is
      for Executable ("synapse_main.adb") use "synapse";
   end Builder;

end Synapse;
