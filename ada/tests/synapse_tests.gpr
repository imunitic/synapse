with "config/synapse_tests_config.gpr";
with "aunit.gpr";

project Synapse_Tests is

   for Source_Dirs use
     ("src", "../src/core", "../src/ports", "../src/adapters", "config/");
   for Object_Dir use "obj/" & Synapse_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("synapse_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use Synapse_Tests_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Synapse_Tests;
