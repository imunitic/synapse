with "config/synapse_tests_config.gpr";
with "aunit.gpr";
with "../synapse_platform.gpr";
with "../vendor/tree-sitter/tree_sitter.gpr";

project Synapse_Tests is

   for Source_Dirs use
     ("src/support", "src/core", "src/core/config", "src/core/formats",
      "src/core/graph", "src/core/json", "src/core/notes", "src/core/text",
      "src/core/util", "src/adapters", "src/adapters/caches",
      "src/adapters/fakes", "src/adapters/git", "src/adapters/stores",
      "src/adapters/system", "src/adapters/tree_sitter", "src/commands",
      "src/hooks", "../src/core", "../src/ports", "../src/adapters",
      "../src/commands", "../src/hooks", "../" & Synapse_Platform.Platform_Dir,
      "config/");
   for Object_Dir use "obj/" & Synapse_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("synapse_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use Synapse_Tests_Config.Ada_Compiler_Switches;
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use Synapse_Platform.Link_Switches;
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Synapse_Tests;
